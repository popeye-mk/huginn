#!/usr/bin/env bash
# Run an ops verb from anywhere.
#
#   ./ops triage
#   ~/path/to/ops-platform/ops history name resolution exposure
#
# Resolves its own location, so the working directory never matters. The
# relative-path stumbles this replaces were not the user's mistake — a
# tool that only works from one directory is a tool with a trap in it.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

PY="$HERE/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3)"

exec "$PY" "$HERE/tools/ops.py" "$@"
